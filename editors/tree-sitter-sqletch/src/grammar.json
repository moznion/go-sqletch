{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "sqletch",
  "rules": {
    "document": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_item"
      }
    },
    "_item": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "header"
        },
        {
          "type": "SYMBOL",
          "name": "param_directive"
        },
        {
          "type": "SYMBOL",
          "name": "column_directive"
        },
        {
          "type": "SYMBOL",
          "name": "_construct"
        },
        {
          "type": "SYMBOL",
          "name": "_sql_content"
        }
      ]
    },
    "_construct": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "if_present_block"
        },
        {
          "type": "SYMBOL",
          "name": "when_block"
        },
        {
          "type": "SYMBOL",
          "name": "choose_block"
        },
        {
          "type": "SYMBOL",
          "name": "order_by_block"
        },
        {
          "type": "SYMBOL",
          "name": "filter_tree_block"
        },
        {
          "type": "SYMBOL",
          "name": "in_expr"
        }
      ]
    },
    "header": {
      "type": "SEQ",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "TOKEN",
            "content": {
              "type": "PREC",
              "value": 3,
              "content": {
                "type": "PATTERN",
                "value": "--[ \\t]*name:"
              }
            }
          },
          "named": true,
          "value": "header_marker"
        },
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "PATTERN",
              "value": "[A-Za-z_][A-Za-z0-9_]*"
            },
            "named": true,
            "value": "query_name"
          }
        },
        {
          "type": "FIELD",
          "name": "annotation",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "PATTERN",
              "value": ":[a-z]+"
            },
            "named": true,
            "value": "annotation"
          }
        }
      ]
    },
    "param_directive": {
      "type": "SEQ",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "TOKEN",
            "content": {
              "type": "PREC",
              "value": 3,
              "content": {
                "type": "PATTERN",
                "value": "--[ \\t]*@param"
              }
            }
          },
          "named": true,
          "value": "directive_marker"
        },
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "PATTERN",
              "value": "[A-Za-z_][A-Za-z0-9_]*"
            },
            "named": true,
            "value": "parameter"
          }
        },
        {
          "type": "STRING",
          "value": ":"
        },
        {
          "type": "FIELD",
          "name": "type",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "PATTERN",
              "value": "[^\\n]+"
            },
            "named": true,
            "value": "type_name"
          }
        }
      ]
    },
    "column_directive": {
      "type": "SEQ",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "TOKEN",
            "content": {
              "type": "PREC",
              "value": 3,
              "content": {
                "type": "PATTERN",
                "value": "--[ \\t]*@column"
              }
            }
          },
          "named": true,
          "value": "directive_marker"
        },
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "PATTERN",
              "value": "[A-Za-z_][A-Za-z0-9_]*"
            },
            "named": true,
            "value": "column_name"
          }
        },
        {
          "type": "STRING",
          "value": ":"
        },
        {
          "type": "FIELD",
          "name": "type",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "PATTERN",
              "value": "[^\\n]+"
            },
            "named": true,
            "value": "type_name"
          }
        }
      ]
    },
    "if_present_block": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "@if-present"
        },
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "FIELD",
          "name": "guards",
          "content": {
            "type": "SYMBOL",
            "name": "parameter_list"
          }
        },
        {
          "type": "STRING",
          "value": ")"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_sql_content"
          }
        },
        {
          "type": "STRING",
          "value": "@endif"
        }
      ]
    },
    "when_block": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "@when"
        },
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "FIELD",
          "name": "param",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "PATTERN",
              "value": "[A-Za-z_][A-Za-z0-9_]*"
            },
            "named": true,
            "value": "parameter"
          }
        },
        {
          "type": "FIELD",
          "name": "op",
          "content": {
            "type": "SYMBOL",
            "name": "comparison"
          }
        },
        {
          "type": "FIELD",
          "name": "value",
          "content": {
            "type": "SYMBOL",
            "name": "literal"
          }
        },
        {
          "type": "STRING",
          "value": ")"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_sql_content"
          }
        },
        {
          "type": "STRING",
          "value": "@end"
        }
      ]
    },
    "choose_block": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "@choose"
        },
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "FIELD",
          "name": "param",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "PATTERN",
              "value": "[A-Za-z_][A-Za-z0-9_]*"
            },
            "named": true,
            "value": "parameter"
          }
        },
        {
          "type": "STRING",
          "value": ")"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "case_clause"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "default_clause"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "@end"
        }
      ]
    },
    "case_clause": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "@case"
        },
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "PATTERN",
              "value": "[A-Za-z_][A-Za-z0-9_]*"
            },
            "named": true,
            "value": "case_name"
          }
        },
        {
          "type": "STRING",
          "value": ")"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_sql_content"
          }
        }
      ]
    },
    "default_clause": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "@default"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_sql_content"
          }
        }
      ]
    },
    "order_by_block": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "@order-by"
        },
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "FIELD",
          "name": "param",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "PATTERN",
              "value": "[A-Za-z_][A-Za-z0-9_]*"
            },
            "named": true,
            "value": "parameter"
          }
        },
        {
          "type": "STRING",
          "value": ")"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "key_clause"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "default_clause"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "@end"
        }
      ]
    },
    "key_clause": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "@key"
        },
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "PATTERN",
              "value": "[A-Za-z_][A-Za-z0-9_]*"
            },
            "named": true,
            "value": "key_name"
          }
        },
        {
          "type": "STRING",
          "value": ")"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_sql_content"
          }
        }
      ]
    },
    "filter_tree_block": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "@filter-tree!"
            },
            {
              "type": "STRING",
              "value": "@filter-tree"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "FIELD",
          "name": "param",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "PATTERN",
              "value": "[A-Za-z_][A-Za-z0-9_]*"
            },
            "named": true,
            "value": "parameter"
          }
        },
        {
          "type": "STRING",
          "value": ")"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "predicate_clause"
          }
        },
        {
          "type": "STRING",
          "value": "@end"
        }
      ]
    },
    "predicate_clause": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "@predicate"
        },
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "PATTERN",
              "value": "[A-Za-z_][A-Za-z0-9_]*"
            },
            "named": true,
            "value": "predicate_name"
          }
        },
        {
          "type": "STRING",
          "value": ")"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_sql_content"
          }
        }
      ]
    },
    "in_expr": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "@in"
        },
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "SYMBOL",
          "name": "param_ref"
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "parameter_list": {
      "type": "SEQ",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "PATTERN",
            "value": "[A-Za-z_][A-Za-z0-9_]*"
          },
          "named": true,
          "value": "parameter"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": ","
              },
              {
                "type": "ALIAS",
                "content": {
                  "type": "PATTERN",
                  "value": "[A-Za-z_][A-Za-z0-9_]*"
                },
                "named": true,
                "value": "parameter"
              }
            ]
          }
        }
      ]
    },
    "comparison": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "="
        },
        {
          "type": "STRING",
          "value": "!="
        },
        {
          "type": "STRING",
          "value": "<>"
        }
      ]
    },
    "literal": {
      "type": "CHOICE",
      "members": [
        {
          "type": "PATTERN",
          "value": "'([^']|'')*'"
        },
        {
          "type": "PATTERN",
          "value": "-?[0-9]+"
        },
        {
          "type": "STRING",
          "value": "true"
        },
        {
          "type": "STRING",
          "value": "false"
        }
      ]
    },
    "_sql_content": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "comment"
        },
        {
          "type": "SYMBOL",
          "name": "block_comment"
        },
        {
          "type": "SYMBOL",
          "name": "string"
        },
        {
          "type": "SYMBOL",
          "name": "quoted_ident"
        },
        {
          "type": "SYMBOL",
          "name": "param_ref"
        },
        {
          "type": "SYMBOL",
          "name": "sql_token"
        }
      ]
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "--[^\\n]*"
        }
      }
    },
    "block_comment": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "/*"
          },
          {
            "type": "PATTERN",
            "value": "([^*]|\\*+[^*/])*\\**"
          },
          {
            "type": "STRING",
            "value": "*/"
          }
        ]
      }
    },
    "string": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "'([^']|'')*'"
      }
    },
    "quoted_ident": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "PATTERN",
            "value": "\"([^\"]|\"\")*\""
          },
          {
            "type": "PATTERN",
            "value": "`([^`]|``)*`"
          },
          {
            "type": "PATTERN",
            "value": "\\[[^\\]]*\\]"
          }
        ]
      }
    },
    "param_ref": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": ":"
          },
          {
            "type": "PATTERN",
            "value": "[A-Za-z_][A-Za-z0-9_]*"
          }
        ]
      }
    },
    "sql_token": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "PATTERN",
            "value": "[^@:'\"`\\[\\-\\/ \\t\\r\\n]+"
          },
          {
            "type": "PATTERN",
            "value": "[:\\-\\/\\[]"
          }
        ]
      }
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "[ \\t\\r\\n]+"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}