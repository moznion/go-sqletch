  "rendered_sql": "\n-- @param status: varchar(32)\n-- @param email_prefix: varchar(255)\n-- @param limit: bigint\nSELECT u.id, u.email, u.status, u.nickname\nFROM users AS u\nWHERE TRUE\n\n\nAND (u.status = ?)\n\n\nAND (u.email LIKE concat(?, '%'))\n\n\nORDER BY u.email ASC\n\nLIMIT ?;\n\n",
