  "rendered_sql": "\nSELECT\n    u.id,\n    u.email,\n    u.status,\n    u.created_at\nFROM users AS u\n\n\nJOIN organization_users AS ou\n  ON ou.user_id = u.id\n AND ou.organization_id = $1\n\nWHERE TRUE\n\n\nAND (u.status = $2)\n\n\nAND (u.email LIKE $3 || '%')\n\n\nAND (u.created_at \u003e= $4)\n\n\nORDER BY u.email ASC, u.id ASC\n\nLIMIT $5;\n\n",
